From 632d7b577777e1a101701d91604de550a6e65329 Mon Sep 17 00:00:00 2001
From: Zac Walker <zac.walker@linaro.org>
Date: Wed, 11 Oct 2023 13:04:45 +0200
Subject: [PATCH 03/10] Add error messages for invalid relocations.

(cherry picked from commit d25493e017dc32c08298bb34ba086a98837b1254)
---
 bfd/reloc.c         | 8 ++++++++
 ld/emultempl/pep.em | 3 ---
 2 files changed, 8 insertions(+), 3 deletions(-)

diff --git a/bfd/reloc.c b/bfd/reloc.c
index 6b9e00da5d6..b9ed4bd1569 100644
--- a/bfd/reloc.c
+++ b/bfd/reloc.c
@@ -1212,6 +1212,14 @@ _bfd_relocate_contents (reloc_howto_type *howto,
   if (howto->negate)
     relocation = -relocation;
 
+  if (howto->bitsize == 21 ||
+      howto->bitsize == 12 ||
+      howto->bitsize == 26)
+    {
+      _bfd_error_handler (_("%pB: %d bit relocation not currently supported.\n"),
+            input_bfd, howto->bitsize);
+    }
+
   /* Get the value we are going to relocate.  */
   x = read_reloc (input_bfd, location, howto);
 
diff --git a/ld/emultempl/pep.em b/ld/emultempl/pep.em
index c9b097c20de..f3760e88e89 100644
--- a/ld/emultempl/pep.em
+++ b/ld/emultempl/pep.em
@@ -1186,9 +1186,6 @@ read_addend (arelent *rel, asection *s)
 	    addend = bfd_get_16 (s->owner, buf);
 	}
       break;
-    case 12:
-    case 21:
-    case 26:
     case 32:
       ok = bfd_get_section_contents (s->owner, s, buf, rel->address, 4);
       if (ok)
-- 
